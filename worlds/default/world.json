  "initial": {
    "lasers_A1": true,
    "lasers_B1": true,
    "fire_A1": true,
    "fire_B1": true,
    "A.flooded_archive.flooded": true,
    "B.loading_bay.flooded": true,
    "A.records.lights": false,
    "B.server.lights": false,
    "B.archive.lights": false
  },

  "derived": { "exit_open": "final_A && final_B" },
  "derivedFx": { "exit_open": "exit_open" },

  "rules": [
    {"on": "button_A1:press", "do": [{"set": {"door_B1": true}}, {"fx": "door_clunk", "to": "B"}]},
    {"on": "button_B1:press", "do": [{"set": {"door_A1": true}}, {"fx": "door_clunk", "to": "A"}]},
    {"on": "keypad_A2:submit", "requires": {"code": "code_B1"}, "do": [{"set": {"door_A2": true}}, {"fx": "door_open", "to": "A"}]},
    {"on": "keypad_B2:submit", "requires": {"code": "code_A1"}, "do": [{"set": {"door_B2": true}}, {"fx": "door_open", "to": "B"}]},
    {"on": "laserlvr_A:toggle", "do": [{"toggle": "lasers_B1"}, {"fx": "laser_powerdown", "to": "B"}]},
    {"on": "laser_B1:toggle", "do": [{"toggle": "lasers_A1"}, {"fx": "laser_powerdown", "to": "A"}]},
    {"on": "sprinkler_A:toggle", "do": [{"set": {"fire_B1": false}}, {"fx": "sprinkler_hiss", "to": "B"}]},
    {"on": "sprinkler_B:toggle", "do": [{"set": {"fire_A1": false}}, {"fx": "sprinkler_hiss", "to": "A"}]},
    {"on": "valve_A:toggle", "do": [{"set": {"B.loading_bay.flooded": false}}, {"fx": "water_drain", "to": "B"}]},
    {"on": "valve_B:toggle", "do": [{"set": {"A.flooded_archive.flooded": false}}, {"fx": "water_drain", "to": "A"}]},
    {"on": "breaker_A:toggle", "do": [{"set": {"door_B3": true}}, {"fx": "door_open", "to": "B"}]},
    {"on": "light_A_srv:toggle", "do": [{"toggle": "B.server.lights"}, {"fx": "lights_hum", "to": "B"}]},
    {"on": "light_A_arc:toggle", "do": [{"toggle": "B.archive.lights"}, {"fx": "lights_hum", "to": "B"}]},
    {"on": "light_B_rec:toggle", "do": [{"toggle": "A.records.lights"}, {"fx": "lights_hum", "to": "A"}]},
    {"on": "wall_A1:use_bomb", "requires": {"holding": "bomb"}, "do": [{"set": {"wall_A1.broken": true}}, {"consume": "bomb"}, {"fx": "explosion", "to": "all"}]},
    {"on": "wall_B1:use_bomb", "requires": {"holding": "bomb"}, "do": [{"set": {"wall_B1.broken": true}}, {"consume": "bomb"}, {"fx": "explosion", "to": "all"}]},
    {"on": "keydoor_A:use_key", "requires": {"holding": "key"}, "do": [{"set": {"keydoor_A.open": true}}, {"consume": "key"}]},
    {"on": "keydoor_B:use_key", "requires": {"holding": "key"}, "do": [{"set": {"keydoor_B.open": true}}, {"consume": "key"}]},
    {"on": "final_A:press", "do": [{"set": {"final_A": true}}, {"fx": "latch", "to": "all"}]},
    {"on": "final_B:press", "do": [{"set": {"final_B": true}}, {"fx": "latch", "to": "all"}]}
  ]
